rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safe admin check: a missing/invalid users document must NOT throw
    // (an exception in an `||` branch would deny the whole rule).
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users: a user can read/write only their own user document; admin can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Customers: same as users
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId);
      allow update, delete: if isOwner(customerId) || isAdmin();
    }

    // Workers: public read, owner write, admin write
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isOwner(workerId);
      allow update: if isOwner(workerId) || isAdmin();
      allow delete: if isOwner(workerId) || isAdmin();
    }

    // Worker Verifications: admin can read/write; worker can read own
    match /workerVerifications/{verificationId} {
      allow read: if isAdmin() || resource.data.workerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit Logs: admin can read/write; no client access
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Bookings: customer reads/writes their own; worker reads/writes their own; admin reads all
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.workerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.workerId == request.auth.uid || isAdmin());
    }

    // Booking reviews (subcollection) — participant readable, author creatable
    match /bookings/{bookingId}/reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Reviews: anyone can read; customer can create; only the reviewer can update/delete; admin can delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // Categories: public read, admin only write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Cities: public read, admin only write
    match /cities/{cityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Payments: customer and worker can read their own; admin can read all
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications: user can read/write their own. A user may create a
    // notification addressed to ANY recipient (e.g. a customer notifying the
    // worker about a booking) using their own auth identity.
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId);
      allow create: if isAuthenticated()
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(["recipientId", "type", "title", "message", "relatedId", "read", "createdAt"]);
      allow update, delete: if isOwner(resource.data.recipientId) || isAdmin();
    }

    // Storage: users can read/write their own files
    match /storage/files/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Subscriptions: user reads own; admin reads all; admin manages
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Memberships: user reads own; admin reads all; admin manages
    match /memberships/{membershipId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Contact Unlocks: customer/worker read own; admin reads all.
    // Customer can create their own unlock (free → status "success",
    // paid → status "pending").  Only admin may update (server-side
    // payment verification via API route uses the Admin SDK which
    // bypasses rules).  This prevents customers from flipping their
    // own pending unlock to success without paying.
    match /contactUnlocks/{unlockId} {
      allow read: if isAuthenticated()
        && (resource.data.customerId == request.auth.uid
            || resource.data.workerId == request.auth.uid
            || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && (
          (request.resource.data.unlockType == "free"
            && request.resource.data.status == "success"
            && request.resource.data.amount == 0)
          || (request.resource.data.unlockType == "paid"
            && request.resource.data.status == "pending")
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Advertisers: creator reads own; admin reads all; admin manages
    match /advertisers/{advertiserId} {
      allow read: if isOwner(resource.data.createdBy) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Transactions: user reads own; customer creates own PENDING (or a
    // ₹0 success record for a free contact unlock).  Only admin may
    // update (server-side payment verification uses the Admin SDK).
    // Prevents customers from marking their own pending payment as
    // success without going through the payment provider.
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == "pending"
            || (request.resource.data.status == "success" && request.resource.data.amount == 0));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Support Requests: customer can create; customer/admin can read own; admin can update
    match /supportRequests/{requestId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
